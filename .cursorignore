# Cursor: exclude from indexing & AI context (gitignore syntax).
# Base: mirrors .gitignore; extras below for weights, media, and log-style dirs.

.vscode

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.zip
*.npy
*.mp4
*.png
*.gif
*.pth
*.pt
*.safetensors
data/processed*
data/raw*
MemFlow/
output/
outputs/
wandb/*
slurm-*.out

# C extensions
*.so

